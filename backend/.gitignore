# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# cache and log files
*.log
.*_cache/

# generated frontend files
**/app/*
!**/app/.gitkeep

# local database files
*.db
*.db-journal

# e2e database
e2e-run.db

# Uploaded pictures. They live beside the database rather than inside it, so they are
# ignored for the same reason it is: an instance's own content, not the application.
media/
e2e-run-media/
