        },
        {
          "ingredient": "unsalted-butter",
          "magnitude": "40",
          "unit": "g",
          "preparation": "melted, plus more for the pan"
        }
      ],
      "steps": [
        {
          "instruction": "Whisk the flour, baking powder, sugar and salt together."
        },
        {
          "instruction": "Beat in the milk, eggs and melted butter until just combined; a few lumps are fine."
