    {
      "title": "Buttermilk Pancakes",
      "summary": "A first recipe to look at, change, and cook.",
      "yield_magnitude": "12",
      "yield_unit": "piece",
      "serves": "4",
      "provenance": "authored",
      "lines": [
        {
          "ingredient": "plain-flour",
          "magnitude": "225",
          "unit": "g",
          "preparation": "sifted"
        },
        {
          "ingredient": "baking-powder",
          "magnitude": "2",
          "unit": "tsp"
        },
        {
          "ingredient": "caster-sugar",
          "magnitude": "2",
          "unit": "tbsp"
        },
        {
          "ingredient": "fine-salt",
          "magnitude": "0.5",
          "unit": "tsp"
        },
