          "magnitude": "300",
          "unit": "ml"
        },
        {
          "ingredient": "egg",
          "magnitude": "2",
          "unit": "piece"
        },
        {
          "ingredient": "unsalted-butter",
          "magnitude": "40",
          "unit": "g",
          "preparation": "melted, plus more for the pan"
        }
      ],
      "steps": [
        {
          "instruction": "Whisk the flour, baking powder, sugar and salt together.",
          "duration_seconds": 120,
          "attention": "hands_on"
        },
        {
          "instruction": "Beat in the milk, eggs and melted butter until just combined; a few lumps are fine.",
          "duration_seconds": 180,
          "attention": "hands_on"
        },
        {
          "instruction": "Rest the batter — this is what makes them tender.",
          "duration_seconds": 1800,
          "attention": "waiting"
        },
        {
          "instruction": "Fry in a buttered pan until the edges set and the bubbles hold.",
          "duration_seconds": 600,
          "temperature_celsius": 180,
          "attention": "hands_on"
        }
      ]
    },
    {
      "title": "Shortbread",
      "summary": "Three ingredients, one bowl, no mixer.",
      "yield_magnitude": "16",
      "yield_unit": "piece",
      "serves": "8",
      "provenance": "authored",
      "lines": [
        {
          "ingredient": "unsalted-butter",
          "magnitude": "225",
          "unit": "g",
          "preparation": "softened"
        },
        {
          "ingredient": "caster-sugar",
          "magnitude": "110",
          "unit": "g"
        },
        {
          "ingredient": "plain-flour",
          "magnitude": "340",
          "unit": "g"
        },
        {
          "ingredient": "fine-salt",
          "magnitude": "0.25",
          "unit": "tsp",
          "optional": true
        }
      ],
      "steps": [
        {
          "instruction": "Cream the butter and sugar until pale.",
          "duration_seconds": 300,
          "attention": "hands_on"
        },
        {
          "instruction": "Work in the flour and salt until it just comes together. Do not knead it.",
          "duration_seconds": 180,
          "attention": "hands_on"
        },
        {
          "instruction": "Press into a tin and prick all over.",
          "duration_seconds": 300,
          "attention": "hands_on"
        },
        {
          "instruction": "Chill until firm.",
          "duration_seconds": 1800,
          "attention": "waiting"
        },
        {
          "instruction": "Bake until the palest gold.",
          "duration_seconds": 2400,
          "temperature_celsius": 160,
          "attention": "waiting"
        },
        {
          "instruction": "Cut while still warm.",
          "duration_seconds": 120,
