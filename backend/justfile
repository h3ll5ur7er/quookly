default:
    @just --list

install:
    uv sync

run *args:
    uv run quookly {{args}}

serve:
    uv run quookly

export-openapi:
    uv run export_openapi > ../openapi.json

test:
    uv run pytest

# What the suite reaches. Not part of `check`: a coverage figure is something to read and
# think about, not a gate to satisfy — and the ways to move it without testing anything
# are easier than the ways to move it by testing something.
coverage *args:
    uv run pytest --cov --cov-report=term-missing {{args}}

lint:
    uv run ruff check .

format:
    uv run ruff format .

# Formatting is a gate, not a suggestion. Without this in `check`, drift accumulates
# quietly and the next `just format` produces a diff belonging to nobody's change.
format-check:
    uv run ruff format --check .

typecheck:
    uv run mypy .

architecture:
    uv run lint-imports

# Apply migrations. Safe to run repeatedly; a fresh database is built by this.
migrate:
    uv run alembic upgrade head

# Stock the ingredient registry from the shipped seed file. Runs at start-up too; this is
# for an operator who wants it done now, or after replacing the seed file.
seed:
    uv run python -c "import asyncio; from quookly.managers.seed import stock_registry; print(f'{asyncio.run(stock_registry())} ingredients added')"

# Generate a migration from the models. Review it before committing.
#
# Upgrades first: autogenerate compares the models against a database at head, and fails
# with an unhelpful message otherwise. Formats after: generated migrations exceed the
# line length, and every one of them would fail the linter unattended.
# Variadic, because the root justfile delegates through `*cmd` and loses quoting — so
# `just backend makemigration unit preferences` has to work without them.
makemigration *message:
    uv run alembic upgrade head
    uv run alembic revision --autogenerate -m "{{message}}"
    uv run ruff format alembic/versions
    uv run ruff check --fix alembic/versions

check:
    just format-check
    just lint
    just typecheck
    just architecture
    just test

clean:
    # pycache
    python3 -Bc "import pathlib; import shutil; [shutil.rmtree(p) for p in pathlib.Path('.').rglob('__pycache__')]"
    # tool caches
    rm -rf .import_linter_cache
    rm -rf .mypy_cache
    rm -rf .pytest_cache
    rm -rf .ruff_cache