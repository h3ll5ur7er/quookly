set shell := ["bash", "-uc"]

default:
    @just --list

_nvm *command:
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}" && \
    source "$NVM_DIR/nvm.sh" && \
    nvm use && \
    {{command}}

install:
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}" && source "$NVM_DIR/nvm.sh" && nvm install
    just _nvm "npm install"

serve:
    just _nvm "npm run start"

build:
    just _nvm "npm run build"

test:
    just _nvm "npm run test"

lint:
    just _nvm "npm run lint"

format:
    just _nvm "npm run format"

format-check:
    just _nvm "npm run format:check"

typecheck:
    just _nvm "npm run typecheck"

# Every foreground/surface token pair must meet WCAG AA in every theme (NFR-15).
contrast:
    just _nvm "npm run check:contrast"

# Extract translatable messages. Catalogues live in public/i18n (ADR-025).
extract-i18n:
    just _nvm "npm run extract-i18n"

# Every translatable message must be answered by every catalogue (FR-10).
i18n:
    just _nvm "npm run check:i18n"

# End-to-end, in a real browser, against the backend serving the built application.
# Builds first: the suite exercises the artefact a self-hoster runs, not the dev server.
e2e:
    just build
    just _nvm "npm run e2e"

check:
    just lint
    just typecheck
    just contrast
    just i18n
    just test

generate-openapi-client:
    just _nvm "npm run generate-openapi"

clean:
    rm -rf .angular
