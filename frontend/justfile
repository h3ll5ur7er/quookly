set shell := ["bash", "-uc"]

default:
    @just --list

# Run a command against the node this project pins.
#
# Through nvm where there is one, and directly where there is not. CI installs the version
# from `.nvmrc` itself and has no nvm to source — falling back means CI runs the same
# commands a developer runs rather than a second set that drifts from them.
_nvm *command:
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}" && \
    if [ -s "$NVM_DIR/nvm.sh" ]; then . "$NVM_DIR/nvm.sh" && nvm use; fi && \
    {{command}}

install:
    # Installs the pinned node where nvm is managing it. CI installs it another way and
    # has no nvm, which is not a failure — the version is pinned either way.
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}" && \
    if [ -s "$NVM_DIR/nvm.sh" ]; then . "$NVM_DIR/nvm.sh" && nvm install; fi
    just _nvm "npm install"

serve:
    just _nvm "npm run start"

build:
    just _nvm "npm run build"

# What the suite reaches. `src/api` is excluded: it is the generated OpenAPI client,
# regenerated on every API change and never hand-edited, and measuring it says nothing
# about this codebase — it dragged the figure down by nine points while meaning nothing.
coverage *args:
    just _nvm "npx ng test --watch false --coverage {{args}}"

test:
    just _nvm "npm run test"

lint:
    just _nvm "npm run lint"

format:
    just _nvm "npm run format"

format-check:
    just _nvm "npm run format:check"

typecheck:
    just _nvm "npm run typecheck"

# Every foreground/surface token pair must meet WCAG AA in every theme (NFR-15).
contrast:
    just _nvm "npm run check:contrast"

# Extract translatable messages. Catalogues live in public/i18n (ADR-025).
extract-i18n:
    just _nvm "npm run extract-i18n"

# Every translatable message must be answered by every catalogue (FR-10).
i18n:
    just _nvm "npm run check:i18n"

# A template using a shared class must import the partial that defines it. Angular scopes
# component styles, so without the import the class silently does nothing.
shared-styles:
    just _nvm "npm run check:shared-styles"

# End-to-end, in a real browser, against the backend serving the built application.
# Builds first: the suite exercises the artefact a self-hoster runs, not the dev server.
e2e:
    just build
    just _nvm "npm run e2e"

check:
    just format-check
    just lint
    just typecheck
    just contrast
    just i18n
    just shared-styles
    just test

generate-openapi-client:
    just _nvm "npm run generate-openapi"

clean:
    rm -rf .angular
