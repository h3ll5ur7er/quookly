# Quookly — instance configuration.
#
#   cp .env.example .env
#   # set QUOOKLY_SECRET_KEY, then:
#   docker compose up -d
#
# Every setting is read from the environment, so nothing inside the image is ever edited.
# Everything here has a working default except the secret key, which deliberately has
# none.

# --- required ---------------------------------------------------------------------------

# Signs the tokens that keep people signed in. At least 32 bytes.
#
# There is no default, and shipping one would give every self-hosted instance on earth the
# same signing key — which is worse than refusing to start. Generate your own:
#
#   openssl rand -base64 48
#
QUOOKLY_SECRET_KEY=

# --- where things are kept ----------------------------------------------------------------

# The database, and the directory pictures are kept in.
#
# Both under /data on purpose. Pictures live beside the database rather than inside it, so
# an instance is **two things to back up** — and putting them under one directory is what
# stops that being a footgun. Back up the volume, not the .db file.
#
# The image sets both already; they are here so it is obvious what the volume holds.
QUOOKLY_DATABASE_URL=sqlite+aiosqlite:////data/quookly.db
QUOOKLY_MEDIA_DIR=/data/media

# The port the container listens on, inside the container.
PORT=8000

# --- a model, if you want one -------------------------------------------------------------

# Quookly works without a model. What it cannot do without one is read a recipe off a blog
# that publishes no structured data, write a recipe from a description, adapt one to a
# change, translate one into your language, or explain a word nobody here has explained.
# Every other screen works, and each of those says plainly that no model is configured
# rather than failing as though something broke.
#
# Any OpenAI-compatible endpoint. A local Ollama, an vLLM on your own hardware, or a
# hosted provider — the same build serves all three, and nothing above the access layer
# knows which one answered.
#
#   Ollama on the host:      http://host.docker.internal:11434/v1
#   Ollama in compose:       http://ollama:11434/v1  (see compose.ollama.yaml)
#
QUOOKLY_INFERENCE_BASE_URL=
QUOOKLY_INFERENCE_MODEL=
QUOOKLY_INFERENCE_API_KEY=

# Local models on modest hardware are slow, and a recipe page is a long prompt. Raise this
# on a slower box rather than wondering why imports time out.
QUOOKLY_INFERENCE_TIMEOUT_SECONDS=180

# --- the rest -----------------------------------------------------------------------------

# Which food composition tables to believe, best first.
#
# Composition data is a measurement of a particular food supply, not a fact about an
# ingredient: Swiss flour is unfortified and American flour is fortified with folic acid
# and iron by law. A kitchen in Bern and one in Toronto want different answers, so the
# order is yours. A source left out is one this instance will not use, even if its figures
# are stored.
QUOOKLY_NUTRITION_SOURCES=swiss,ciqual,cofid,usda

# Importing a recipe fetches a URL somebody pasted, from the server's network. Private
# addresses are refused so that a pasted link cannot be used to reach things on your LAN
# that are not on the internet. Turn this on deliberately if your recipe box is one of
# them.
QUOOKLY_ALLOW_PRIVATE_FETCH=false
QUOOKLY_FETCH_TIMEOUT_SECONDS=20

# How long somebody stays signed in.
QUOOKLY_TOKEN_LIFETIME_HOURS=12

# DEBUG while you are working out why something happened; INFO otherwise.
QUOOKLY_LOG_LEVEL=INFO
