{
  "openapi": "3.1.0",
  "info": {
    "title": "Quookly API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Get Status",
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/bootstrap": {
      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Get Bootstrap State",
        "description": "Whether this instance still needs its first admin. Public by necessity.",
        "operationId": "getBootstrapState",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapState"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "accounts"
        ],
        "summary": "Bootstrap Admin",
        "description": "Claim a fresh instance by creating its first, admin, account.",
        "operationId": "bootstrapAdmin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts": {
      "post": {
        "tags": [
          "accounts"
        ],
        "summary": "Register Cook",
        "description": "Create an account.",
        "operationId": "registerCook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/sign-in": {
      "post": {
        "tags": [
          "accounts"
        ],
        "summary": "Sign In",
        "description": "Exchange credentials for a token.",
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authenticated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "List Recipes",
        "description": "The cook's own recipes.",
        "operationId": "listRecipes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecipeSummaryView"
                  },
                  "type": "array",
                  "title": "Response Listrecipes"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Create Recipe",
        "description": "Author a recipe.",
        "operationId": "createRecipe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentedRecipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{recipe_id}": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Get Recipe",
        "description": "A recipe, scaled and in the cook's preferred units.",
        "operationId": "getRecipe",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          },
          {
            "name": "servings",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Show the recipe at this yield, in whatever the recipe itself yields.",
              "title": "Servings"
            },
            "description": "Show the recipe at this yield, in whatever the recipe itself yields."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentedRecipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "readRoot",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Authenticated": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "cook": {
            "$ref": "#/components/schemas/Cook"
          }
        },
        "type": "object",
        "required": [
          "token",
          "cook"
        ],
        "title": "Authenticated",
        "description": "A signed-in cook and the token proving it."
      },
      "BootstrapState": {
        "properties": {
          "required": {
            "type": "boolean",
            "title": "Required"
          }
        },
        "type": "object",
        "required": [
          "required"
        ],
        "title": "BootstrapState",
        "description": "Whether the instance still needs its first admin."
      },
      "Cook": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          },
          "registered_at": {
            "type": "string",
            "format": "date-time",
            "title": "Registered At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "is_admin",
          "registered_at"
        ],
        "title": "Cook",
        "description": "A cook account, safe to pass anywhere in the application.\n\nThe password hash is deliberately absent. Anything needing it asks for a\n`StoredCredential`, which keeps credentials on the authentication path instead of\nriding along in every value that happens to describe a cook."
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "description": "A request to sign in. No length rule \u2014 an old password is still the password."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngredientLineInput": {
        "properties": {
          "ingredient_id": {
            "type": "integer",
            "title": "Ingredient Id"
          },
          "magnitude": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Magnitude"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "preparation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Preparation"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "ingredient_id",
          "magnitude",
          "unit"
        ],
        "title": "IngredientLineInput",
        "description": "One line of a recipe being authored."
      },
      "PresentedLine": {
        "properties": {
          "ingredient": {
            "type": "string",
            "title": "Ingredient"
          },
          "quantity": {
            "$ref": "#/components/schemas/QuantityView"
          },
          "preparation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preparation"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "ingredient",
          "quantity"
        ],
        "title": "PresentedLine"
      },
      "PresentedRecipe": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "yield_quantity": {
            "$ref": "#/components/schemas/QuantityView"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/PresentedLine"
            },
            "type": "array",
            "title": "Lines"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/PresentedStep"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "yield_quantity",
          "visibility",
          "provenance",
          "lines",
          "steps"
        ],
        "title": "PresentedRecipe",
        "description": "A recipe scaled and rendered for one cook, ready to display."
      },
      "PresentedStep": {
        "properties": {
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "instruction": {
            "type": "string",
            "title": "Instruction"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "temperature_celsius": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature Celsius"
          }
        },
        "type": "object",
        "required": [
          "position",
          "instruction"
        ],
        "title": "PresentedStep"
      },
      "Provenance": {
        "type": "string",
        "enum": [
          "authored",
          "imported_json",
          "imported_url",
          "generated"
        ],
        "title": "Provenance",
        "description": "How a recipe came to exist (V1).\n\nRecorded because it is worth knowing, but a recipe's usefulness never depends on it \u2014\nevery path ends in the same canonical structure."
      },
      "QuantityView": {
        "properties": {
          "magnitude": {
            "type": "string",
            "title": "Magnitude"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "display": {
            "type": "string",
            "title": "Display"
          }
        },
        "type": "object",
        "required": [
          "magnitude",
          "unit",
          "display"
        ],
        "title": "QuantityView",
        "description": "A quantity as a client reads it.\n\n`magnitude` is a string. JSON numbers are binary floats in a browser, and 0.1 of a\ngram is not worth losing to that; `display` is what a screen actually shows."
      },
      "RecipeInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "yield_magnitude": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Yield Magnitude"
          },
          "yield_unit": {
            "type": "string",
            "title": "Yield Unit"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/IngredientLineInput"
            },
            "type": "array",
            "minItems": 1,
            "title": "Lines"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepInput"
            },
            "type": "array",
            "minItems": 1,
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "title",
          "yield_magnitude",
          "yield_unit",
          "lines",
          "steps"
        ],
        "title": "RecipeInput",
        "description": "A recipe being authored (UC-1.1)."
      },
      "RecipeSummaryView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "yield_quantity": {
            "$ref": "#/components/schemas/QuantityView"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "yield_quantity",
          "visibility"
        ],
        "title": "RecipeSummaryView"
      },
      "Registration": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "title": "Registration",
        "description": "A request to create an account.\n\nThe password rule lives here rather than in the manager: it constrains the shape of\nthe input, so it is the contract's business, and stating it here means the API\nrejects a short password before any work is done."
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusResponse"
      },
      "StepInput": {
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Instruction"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "temperature_celsius": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature Celsius"
          }
        },
        "type": "object",
        "required": [
          "instruction"
        ],
        "title": "StepInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Visibility": {
        "type": "string",
        "enum": [
          "private",
          "public"
        ],
        "title": "Visibility",
        "description": "Private by default; publishing is explicit (FR-5)."
      }
    }
  }
}
